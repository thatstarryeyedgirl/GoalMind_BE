{
  "builds": [
    {
      "src": "goalmind/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "staticfiles_build/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "goalmind/wsgi.py"
    }
  ]
}
